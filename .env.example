# Copy this file to .env and fill in the values. Never commit .env.

# Google AI Studio key (https://aistudio.google.com/apikey). Free tier is enough.
GEMINI_API_KEY=

# Model used to read invoices (pinned; verified on sample 01). If it is busy, unavailable or hangs,
# the fallbacks are tried in order. Check which ones answer: node --env-file=.env tools/gemini-pick.mjs
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.8-flash,gemini-3.5-flash

# MongoDB Atlas connection string. Leave empty to keep runs in memory (lost on restart; fine for local testing).
MONGODB_URI=

# When an invoice has no PO number and exactly one open PO fits: hold (suggest it, a person confirms) or approve.
INFERRED_PO_POLICY=hold

# Invoices above this total in rupees (incl. GST) always need a person. 0 = no limit.
AUTO_APPROVE_LIMIT=1000000

# gemini (real) | mock (automated tests only: returns fixtures for the bundled samples, does NOT read PDFs)
EXTRACTOR=gemini

PORT=4000
